{
	"name": "affilicard",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"description": "汎用アフィリエイト商品カード WordPress プラグインの JS ビルド",
	"engines": {
		"node": ">=18.12.0"
	},
	"volta": {
		"node": "20.18.1"
	},
	"scripts": {
		"build": "wp-scripts build src/Block/index.js src/Admin/settings.js src/Admin/metabox.js --output-path=build",
		"start": "wp-scripts start src/Block/index.js src/Admin/settings.js src/Admin/metabox.js --output-path=build",
		"lint:js": "wp-scripts lint-js src",
		"test:js": "wp-scripts test-unit-js --passWithNoTests",
		"format:js": "wp-scripts format src"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@wordpress/scripts": "^32.3.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.47.0",
		"@wordpress/components": "^29.12.0",
		"@wordpress/data": "^10.47.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/i18n": "^5.26.0"
	}
}
