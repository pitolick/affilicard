{
	"name": "affilicard",
	"version": "3.1.0",
	"private": true,
	"license": "GPL-2.0-or-later",
	"description": "汎用アフィリエイト商品カード WordPress プラグインの JS ビルド",
	"engines": {
		"node": ">=18.12.0"
	},
	"volta": {
		"node": "20.18.1"
	},
	"scripts": {
		"build": "wp-scripts build src/Block/index.js src/Admin/settings.js src/Admin/metabox.js --output-path=build",
		"start": "wp-scripts start src/Block/index.js src/Admin/settings.js src/Admin/metabox.js --output-path=build",
		"lint:js": "wp-scripts lint-js src",
		"test:js": "wp-scripts test-unit-js --passWithNoTests",
		"format:js": "wp-scripts format src",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:logs": "wp-env logs --watch=false",
		"test:e2e": "playwright test --config=playwright.config.js"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@wordpress/env": "^11.11.0",
		"@wordpress/scripts": "^32.6.0",
		"eslint": "^10.8.0",
		"prettier": "^3.9.6"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.51.0",
		"@wordpress/components": "^37.0.0",
		"@wordpress/data": "^10.51.0",
		"@wordpress/element": "^8.2.0",
		"@wordpress/i18n": "^6.24.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
