{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "affilicard/product-card",
	"title": "Affilicard 商品カード",
	"category": "widgets",
	"icon": "products",
	"description": "登録済みの Affilicard 商品をカード形式で表示します。",
	"textdomain": "affilicard",
	"supports": {
		"html": false,
		"align": ["wide"]
	},
	"attributes": {
		"productId": { "type": "integer" },
		"externalId": { "type": "string" },
		"platform": { "type": "string" },
		"slug": { "type": "string" },
		"hidePlatforms": {
			"type": "array",
			"items": { "type": "string" },
			"default": []
		},
		"onlyPlatforms": {
			"type": "array",
			"items": { "type": "string" },
			"default": []
		},
		"ctaBgColor": { "type": "string" },
		"ctaTextColor": { "type": "string" },
		"cardBgColor": { "type": "string" },
		"cardBorderColor": { "type": "string" },
		"ctaLabelOverrides": {
			"type": "object",
			"default": {}
		},
		"maskBlur": { "type": "boolean" },
		"maskR18": { "type": "boolean" },
		"maskLabel": { "type": "string" }
	}
}
