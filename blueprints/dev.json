{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Affilicard 開発用 Playground",
    "description": "feature ブランチの affilicard プラグインを試用する Blueprint。"
  },
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "phpExtensionBundles": ["kitchen-sink"],
  "landingPage": "/wp-admin/edit.php?post_type=affilicard_product",
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/pitolick/affilicard",
        "ref": "main",
        "refType": "branch",
        "path": "/"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
