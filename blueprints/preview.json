{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"login": true,
	"landingPage": "/",
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "ja"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"timezone_string": "Asia/Tokyo",
				"gmt_offset": "",
				"start_of_week": "0"
			}
		},
		{
			"step": "installPlugin",
			"pluginZipFile": { "resource": "url", "url": "{{ARTIFACT_URL:affilicard}}" },
			"options": { "activate": true }
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/affilicard/blueprints/demo-seed.php';"
		}
	]
}
