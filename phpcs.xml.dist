<?xml version="1.0"?>
<ruleset name="Affilicard">
    <description>Affilicard WordPress プラグインのコーディング規約。モダン PHP 8.1+ ベースの設計のため、WPCS の一部ルールを緩和している。</description>

    <file>./src</file>
    <file>./tests</file>
    <file>./affilicard.php</file>
    <file>./uninstall.php</file>

    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>node_modules/</exclude-pattern>
    <exclude-pattern>build/</exclude-pattern>
    <exclude-pattern>dist/</exclude-pattern>
    <!-- E2E ツール用 PHP（wp eval-file で実行するシードスクリプト）は WPCS 対象外 -->
    <exclude-pattern>tests/e2e/</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="minimum_supported_wp_version" value="6.8"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress">
        <!-- PSR-4 namespaced ファイル名は kebab-case 規約と衝突するため除外 -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- モダン PHP 8.1+ ベースのため camelCase メソッド / プロパティ / 変数を許容 -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase"/>

        <!-- 型ヒント + readonly props 主体のため docblock @param 強制は緩和 -->
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamName"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamNameNoMatch"/>
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingReturn"/>
        <exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>

        <!-- 日本語コメント主体のため、ASCII 句読点末尾の強制を除外 -->
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>

        <!-- REST controller 等で $namespace / $default を引数名として使うため除外 -->
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.namespaceFound"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.defaultFound"/>

        <!-- Crypto は AES-CBC のための base64、JsonField は wp_json_encode フォールバックの json_encode を使う -->
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
        <exclude name="WordPress.WP.AlternativeFunctions.json_encode_json_encode"/>

        <!-- WP コールバックや interface 実装は引数固定のため "未使用" 警告は noise -->
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>

        <!-- 日本語コメント主体のため、句読点・大文字始まり強制を除外 -->
        <exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
        <exclude name="Generic.Commenting.DocComment.LongNotCapital"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>

        <!-- countFallbackProducts は $wpdb->prepare で生成した SQL を get_col に渡しているが、PHPCS が静的解析できないため除外 -->
        <exclude name="WordPress.DB.PreparedSQL.NotPrepared"/>

        <!-- meta_query / 直接 DB 呼出しは設計判断 (Phase 4a-3 で cache 層検討) -->
        <exclude name="WordPress.DB.SlowDBQuery.slow_db_query_meta_query"/>
        <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
        <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    </rule>

    <!-- tests/bootstrap.php は複数の WP コアクラス stub を一括宣言するため 1-class-per-file 規約を除外 -->
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>tests/bootstrap\.php</exclude-pattern>
    </rule>

    <!-- tests/bootstrap.php は WP コアクラス stub と did_action()/doing_action() 等の関数 stub を
         同一ファイルに一括宣言するため、function/OO 混在禁止規約を除外 -->
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>tests/bootstrap\.php</exclude-pattern>
    </rule>

    <!-- テストコードは $GLOBALS['wpdb'] への代入で wpdb をモックする -->
    <rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
        <exclude-pattern>tests/</exclude-pattern>
    </rule>

    <!-- テスト用 bootstrap は global 変数や fwrite を許容 -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/bootstrap\.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
        <exclude-pattern>tests/bootstrap\.php</exclude-pattern>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="affilicard"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="affilicard"/>
                <element value="Affilicard"/>
                <element value="AFFILICARD"/>
            </property>
        </properties>
    </rule>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
